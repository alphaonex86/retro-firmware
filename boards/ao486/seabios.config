# Appended to the common seabios.config. SeaBIOS's coreboot build, started at the reset vector without coreboot
# (NEWBIOS_BOARD_AO486): the setup utility and the POST screen need that build.
CONFIG_COREBOOT=y
# CONFIG_QEMU is not set
# CONFIG_NEWBIOS_BOARD_MB8433 is not set
CONFIG_NEWBIOS_BOARD_AO486=y
# The image runs uncompressed from E0000-FFFFF
CONFIG_ROM_SIZE=128
# The core's CMOS is not battery-backed: defaults at each power-on must not halt the boot
CONFIG_NEWBIOS_HALT_ON=1
# ISA-only PC: no PCI, no USB controller (the HPS turns the USB keyboard into a PS/2 one)
# CONFIG_USB is not set
# CONFIG_PCIBIOS is not set
# CONFIG_PNPBIOS is not set
# CONFIG_NEWBIOS_TOOL_INFO_PCI is not set
# CONFIG_NEWBIOS_TOOL_INFO_USB is not set
# The HPS daemon serves hard disk images only
# CONFIG_FLOPPY is not set
# CONFIG_CDROM_BOOT is not set
# CONFIG_CDROM_EMU is not set
# CONFIG_BOOTSPLASH is not set
# CONFIG_TCGBIOS is not set
# As the other 486 boards (the MB-8433's config_seabios): no hardware of these on an ISA 486
CONFIG_ATA_PIO32=y
# CONFIG_ENTRY_EXTRASTACK is not set
# CONFIG_MULTIBOOT is not set
# CONFIG_SDCARD is not set
# CONFIG_MEGASAS is not set
# CONFIG_FLASH_FLOPPY is not set
# CONFIG_NVME is not set
# CONFIG_SERCON is not set
# CONFIG_PMTIMER is not set
# CONFIG_TSC_TIMER is not set
# CONFIG_KBD_CALL_INT15_4F is not set
# CONFIG_S3_RESUME is not set
# CONFIG_VGAHOOKS is not set
# CONFIG_DEBUG_COREBOOT is not set
