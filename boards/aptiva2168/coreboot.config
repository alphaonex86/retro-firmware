# The board's coreboot settings, completed by build.sh (payload, POST codes) and firmware.sh (no console);
# the rest as on the MB-8433UUD-A.
CONFIG_VENDOR_IBM=y
CONFIG_BOARD_IBM_APTIVA2168=y
CONFIG_ANY_TOOLCHAIN=y
CONFIG_CCACHE=y
CONFIG_CPU_486_NO_SMM=y
# CONFIG_COLLECT_TIMESTAMPS is not set
# CONFIG_CONSOLE_CBMEM is not set
# CONFIG_CONSOLE_USE_ANSI_ESCAPES is not set
# CONFIG_CONSOLE_USE_LOGLEVEL_PREFIX is not set
# CONFIG_INCLUDE_BUILD_INFO is not set
# CONFIG_INCLUDE_CONFIG_FILE is not set
# CONFIG_USE_BLOBS is not set
# SeaBIOS runs the option ROMs
# CONFIG_VGA_ROM_RUN is not set
CONFIG_NO_GFX_INIT=y
# No SMBIOS (MS-DOS, FreeDOS, Linux only); the mainboard selects no HAVE_ACPI_TABLES: no ACPI either.
# CONFIG_GENERATE_SMBIOS_TABLES is not set
